{
  "dimension": "dragonminez:namek",

  // Opts this dimension into the full zone/heat/tier/boss-gate/capsule-loot system, no safe ring.
  "managed": true,

  // Real DMZ biome_modifier data (namek_soldiers.json) - restricted to two specific Namek
  // biomes, not "anywhere on Namek". All three Frieza Soldier tiers, equal weight.
  "enemies": [
    { "entity": "dragonminez:saga_friezasoldier01", "weight": 2, "biomes": ["dragonminez:ajissa_plains", "dragonminez:sacred_land"] },
    { "entity": "dragonminez:saga_friezasoldier02", "weight": 2, "biomes": ["dragonminez:ajissa_plains", "dragonminez:sacred_land"] },
    { "entity": "dragonminez:saga_friezasoldier03", "weight": 2, "biomes": ["dragonminez:ajissa_plains", "dragonminez:sacred_land"] }
  ],

  // Global tier slice on the shared 1-19 scale (see stats/ZoneHeatLevels) - real floors 332,000
  // to 384,471.
  "tier_range": { "min": 4, "max": 5 },

  // 10-to-60-minute linear pacing scale by tier position - Namek is tier 4.
  "tier_up_duration_seconds": 1140,

  // What Battle Power each of this dimension's own global tiers starts at (dmzplus), or its own
  // local levels (base, no DMZPlus). Sparse - a missing entry falls back to the mod's built-in
  // default. dmzplus is this dimension's own real tier 4-5 floors. base holds the real shared
  // 5-level ladder every dimension uses without DMZPlus (identical here to every other dimension's
  // own base block) - edit just this file's copy to make Namek specifically harder/easier than the
  // shared default in base mode; every other dimension's own base block stays unaffected.
  "tier_floors": {
    "dmzplus": { "4": 332000, "5": 384471 },
    "base": { "1": 0, "2": 68000, "3": 200000, "4": 500000, "5": 1000000 }
  },

  // Zone Capsule loot point ranges for this dimension's own tiers - same dmzplus/base split as
  // tier_floors above, same "real shared values, edit this copy to override just Namek" rule.
  "zone_capsule_tiers": {
    "dmzplus": {
      "4": { "min_points": 10, "max_points": 25 },
      "5": { "min_points": 29, "max_points": 57 }
    },
    "base": {
      "4": { "min_points": 10, "max_points": 25 },
      "5": { "min_points": 50, "max_points": 100 }
    }
  }
}
