{
  "dimension": "minecraft:overworld",

  // Overworld is always part of the zone system regardless of this flag - hardcoded in
  // ManagedDimensions itself so a missing/misconfigured file can never take the mod's home
  // dimension out of the system. Set here anyway for clarity/consistency with every other file.
  "managed": true,

  // Real DMZ biome_modifier data (dinosaurs.json/robots.json/sabertooth.json/saibamans.json) -
  // not a flat "anywhere in the dimension" roster. Biome tags are minecraft-namespaced unless
  // written as a full id (dragonminez:rocky, etc.) - # prefix means a tag, plain means one exact
  // biome.
  "enemies": [
    { "entity": "dragonminez:dino1", "weight": 22,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:is_badlands", "#minecraft:is_mountain", "#minecraft:is_hill", "dragonminez:rocky"] },
    { "entity": "dragonminez:dino2", "weight": 18,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:is_badlands", "#minecraft:is_mountain", "#minecraft:is_hill", "dragonminez:rocky"] },
    { "entity": "dragonminez:dino3", "weight": 14,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:is_badlands", "#minecraft:is_mountain", "#minecraft:is_hill", "dragonminez:rocky"] },
    { "entity": "dragonminez:dinokid", "weight": 10,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:is_badlands", "#minecraft:is_mountain", "#minecraft:is_hill", "dragonminez:rocky"] },

    { "entity": "dragonminez:red_ribbon_soldier", "weight": 45,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:has_structure/village_plains", "#minecraft:has_structure/village_snowy"] },
    { "entity": "dragonminez:robot3", "weight": 10,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:has_structure/village_plains", "#minecraft:has_structure/village_snowy"] },
    { "entity": "dragonminez:robot2", "weight": 10,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:has_structure/village_plains", "#minecraft:has_structure/village_snowy"] },
    { "entity": "dragonminez:robot1", "weight": 5,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:has_structure/village_plains", "#minecraft:has_structure/village_snowy"] },

    // Sabertooth and Bandit share this biome set (real DMZ data - Bandit is grouped with
    // Sabertooth, not the Red Ribbon robots above, despite the name).
    { "entity": "dragonminez:sabertooth", "weight": 18,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:is_savanna", "#minecraft:has_structure/village_plains", "#minecraft:is_forest", "#minecraft:has_structure/woodland_mansion", "#minecraft:is_jungle"] },
    { "entity": "dragonminez:bandit", "weight": 12,
      "biomes": ["#minecraft:has_structure/village_savanna", "#minecraft:is_savanna", "#minecraft:has_structure/village_plains", "#minecraft:is_forest", "#minecraft:has_structure/woodland_mansion", "#minecraft:is_jungle"] },

    // Rocky Biome only, all six Saibaman tiers.
    { "entity": "dragonminez:saga_saibaman1", "weight": 80, "biomes": ["dragonminez:rocky"] },
    { "entity": "dragonminez:saga_saibaman2", "weight": 70, "biomes": ["dragonminez:rocky"] },
    { "entity": "dragonminez:saga_saibaman3", "weight": 60, "biomes": ["dragonminez:rocky"] },
    { "entity": "dragonminez:saga_saibaman4", "weight": 45, "biomes": ["dragonminez:rocky"] },
    { "entity": "dragonminez:saga_saibaman5", "weight": 35, "biomes": ["dragonminez:rocky"] },
    { "entity": "dragonminez:saga_saibaman6", "weight": 25, "biomes": ["dragonminez:rocky"] }
  ],

  // Global tier slice on the shared 1-19 scale (see stats/ZoneHeatLevels) - real floors 68,000 to
  // 195,712 (tier 3's own ceiling, 332,000, is where a character is considered ready to leave the
  // starting planet).
  "tier_range": { "min": 1, "max": 3 },

  // 10-to-60-minute linear pacing scale by tier position - Overworld is tier 1,
  // the low end of the scale. A callback to the old real "68,000 BP at 10 minutes" checkpoint.
  "tier_up_duration_seconds": 600,

  // What Battle Power each of this dimension's own global tiers starts at (dmzplus), or its own
  // local levels (base, no DMZPlus). Sparse - a missing entry falls back to the mod's built-in
  // default. Overworld's dmzplus block is its own real tier 1-3 floors. base holds the real shared
  // 5-level ladder every dimension uses without DMZPlus (identical to every other dimension's own
  // base block) - edit just this file's copy to make Overworld specifically harder/easier than the
  // shared default in base mode; every other dimension's own base block stays unaffected.
  "tier_floors": {
    "dmzplus": { "1": 68000, "2": 115362, "3": 195712 },
    "base": { "1": 0, "2": 68000, "3": 200000, "4": 500000, "5": 1000000 }
  },

  // Zone Capsule loot point ranges for this dimension's own tiers - same dmzplus/base split as
  // tier_floors above. Overworld's dmzplus block is deliberately empty for tiers 1-3 (no entry =
  // no drop, the "give players a reason to leave the starting planet" intent). base holds the real
  // shared levels 4/5 values (same "edit this copy to override just Overworld" rule as tier_floors
  // above) - Overworld's own levels 1-3 never reach them anyway, since base mode's own
  // zoneCapsuleTierRequirement gate blocks them first.
  "zone_capsule_tiers": {
    "dmzplus": { },
    "base": {
      "4": { "min_points": 10, "max_points": 25 },
      "5": { "min_points": 50, "max_points": 100 }
    }
  },

  // The Overworld's ring/easing system - always live regardless of whether DMZPlus is installed,
  // a separate, older mechanic from the tier system above. Every value below is today's real,
  // already-tuned live default; a server owner who never touches this section gets byte-identical
  // behavior to before this file existed. Any field can be omitted to keep its own default.
  "starting_zone": {
    "radius": 2000,
    "battle_power_cap": 68000,
    "minimum_battle_power": 1,
    "early_game_start_factor": 0.6,
    "early_game_health_start_factor": 0.8,
    "early_game_full_strength_bp": 10000,
    "early_game_damage_per_hit_fraction": 0.028,
    "early_game_damage_ramp_exponent": 0.6,
    "damage_reference_release_percent": 50,
    "damage_min_assumed_release_percent": 20
  }
}
