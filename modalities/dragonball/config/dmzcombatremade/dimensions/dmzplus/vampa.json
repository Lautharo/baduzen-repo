{
  "dimension": "dmzplus:vampa",

  // Opts this dimension into the full zone/heat/tier/boss-gate/capsule-loot system, no safe ring.
  "managed": true,

  // Dinosaurs plus Sabertooth, no Bandit here (that's Cereal's own flavor instead). Stray and
  // Skeleton added for real canon reasons - Vampa is the icy wasteland planet from the Broly
  // movie, and Stray is vanilla's own snow/ice skeleton variant.
  "enemies": [
    { "entity": "dragonminez:sabertooth", "weight": 18 },
    { "entity": "dragonminez:dino1", "weight": 22 },
    { "entity": "dragonminez:dino2", "weight": 18 },
    { "entity": "dragonminez:dino3", "weight": 14 },
    { "entity": "dragonminez:dinokid", "weight": 10 },
    { "entity": "minecraft:stray", "weight": 15 },
    { "entity": "minecraft:skeleton", "weight": 10 }
  ],

  // Global tier slice on the shared 1-19 scale (see stats/ZoneHeatLevels) - real floors
  // ~1,073,842 to ~1,440,094.
  "tier_range": { "min": 12, "max": 13 },

  // 10-to-60-minute linear pacing scale by tier position - Vampa is tier 12.
  "tier_up_duration_seconds": 2520,

  // Tier floors and Zone Capsule loot for this dimension's own tiers - see namek.json for the full
  // explanation of the dmzplus/base split. base holds the real shared 5-level ladder/point ranges
  // every dimension uses without DMZPlus (identical here to every other dimension's own base block)
  // - edit just this file's copy to override just Vampa in base mode.
  "tier_floors": {
    "dmzplus": { "12": 1073842, "13": 1243557 },
    "base": { "1": 0, "2": 68000, "3": 200000, "4": 500000, "5": 1000000 }
  },
  "zone_capsule_tiers": {
    "dmzplus": {
      "12": { "min_points": 165, "max_points": 278 },
      "13": { "min_points": 184, "max_points": 310 }
    },
    "base": {
      "4": { "min_points": 10, "max_points": 25 },
      "5": { "min_points": 50, "max_points": 100 }
    }
  }
}
