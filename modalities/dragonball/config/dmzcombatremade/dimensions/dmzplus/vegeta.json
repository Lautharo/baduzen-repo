{
  "dimension": "dmzplus:vegeta",

  // Opts this dimension into the full zone/heat/tier/boss-gate/capsule-loot system, no safe ring.
  "managed": true,

  // Full Red Ribbon Army lineup plus all 3 Frieza Soldier tiers. Vindicator and Pillager added -
  // militaristic vanilla mobs fit a world under Frieza Force occupation better than undead would.
  "enemies": [
    { "entity": "dragonminez:red_ribbon_soldier", "weight": 45 },
    { "entity": "dragonminez:robot3", "weight": 10 },
    { "entity": "dragonminez:robot2", "weight": 10 },
    { "entity": "dragonminez:robot1", "weight": 5 },
    { "entity": "dragonminez:saga_friezasoldier01", "weight": 2 },
    { "entity": "dragonminez:saga_friezasoldier02", "weight": 2 },
    { "entity": "dragonminez:saga_friezasoldier03", "weight": 2 },
    { "entity": "minecraft:pillager", "weight": 15 },
    { "entity": "minecraft:vindicator", "weight": 10 }
  ],

  // 10g gravity per DMZPlus's own planet data - the second-hardest of the 6 planets.
  // Global tier slice on the shared 1-19 scale (see stats/ZoneHeatLevels) - real floors
  // ~1,440,094 to ~1,931,264.
  "tier_range": { "min": 14, "max": 15 },

  // 10-to-60-minute linear pacing scale by tier position - Vegeta is tier 14.
  "tier_up_duration_seconds": 2880,

  // Tier floors and Zone Capsule loot for this dimension's own tiers - see namek.json for the full
  // explanation of the dmzplus/base split. base holds the real shared 5-level ladder/point ranges
  // every dimension uses without DMZPlus (identical here to every other dimension's own base block)
  // - edit just this file's copy to override just Vegeta in base mode.
  "tier_floors": {
    "dmzplus": { "14": 1440094, "15": 1667693 },
    "base": { "1": 0, "2": 68000, "3": 200000, "4": 500000, "5": 1000000 }
  },
  "zone_capsule_tiers": {
    "dmzplus": {
      "14": { "min_points": 203, "max_points": 342 },
      "15": { "min_points": 223, "max_points": 373 }
    },
    "base": {
      "4": { "min_points": 10, "max_points": 25 },
      "5": { "min_points": 50, "max_points": 100 }
    }
  }
}
