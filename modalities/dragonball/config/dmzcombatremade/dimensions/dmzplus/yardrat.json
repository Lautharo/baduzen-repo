{
  "dimension": "dmzplus:yardrat",

  // Opts this dimension into the full zone/heat/tier/boss-gate/capsule-loot system, no safe ring.
  "managed": true,

  // Saibaman tiers 1-3 (the weaker half of the line, matching how this planet has always been
  // rostered - not the full 1-6 range the Overworld gets), plus Enderman - a real thematic tie-in
  // to Yardrat being canonically where Goku learned Instant Transmission, not a random pick.
  "enemies": [
    { "entity": "dragonminez:saga_saibaman1", "weight": 80 },
    { "entity": "dragonminez:saga_saibaman2", "weight": 70 },
    { "entity": "dragonminez:saga_saibaman3", "weight": 60 },
    { "entity": "minecraft:enderman", "weight": 15 }
  ],

  // Global tier slice on the shared 1-19 scale (see stats/ZoneHeatLevels) - real floors ~597,090
  // to ~800,737.
  "tier_range": { "min": 8, "max": 9 },

  // 10-to-60-minute linear pacing scale by tier position - Yardrat is tier 8.
  "tier_up_duration_seconds": 1860,

  // Tier floors and Zone Capsule loot for this dimension's own tiers - see namek.json for the full
  // explanation of the dmzplus/base split. base holds the real shared 5-level ladder/point ranges
  // every dimension uses without DMZPlus (identical here to every other dimension's own base block)
  // - edit just this file's copy to override just Yardrat in base mode.
  "tier_floors": {
    "dmzplus": { "8": 597090, "9": 691456 },
    "base": { "1": 0, "2": 68000, "3": 200000, "4": 500000, "5": 1000000 }
  },
  "zone_capsule_tiers": {
    "dmzplus": {
      "8": { "min_points": 87, "max_points": 152 },
      "9": { "min_points": 107, "max_points": 183 }
    },
    "base": {
      "4": { "min_points": 10, "max_points": 25 },
      "5": { "min_points": 50, "max_points": 100 }
    }
  }
}
