{
  "general": {
    // Master toggle. If false, this mod does nothing - every managed mob keeps DMZ's own flat, hand-authored baseline stats.
    "enableMod": true,

    // Also applies this mod's whole pipeline (stat rolls, Elite rolls, zone participation, capsule loot) to vanilla hostile mobs, not just DMZ's own managed species.
    // DMZ's own named story bosses are never affected either way, regardless of this setting.
    "enableVanillaMobScaling": false

  },

  "statRoll": {
    // Floor Battle Power used when no player is nearby to scale off of, or a player's peak BP hasn't been sampled yet.
    // Range: 1 to 100000000
    "referenceBattlePower": 2000,

    // A normal (non-Elite) mob's target Battle Power is the nearby player's own peak BP times this factor. 1.05 means equal to or slightly above the player.
    // Range: 0.5 to 5
    "baselineOvershootFactor": 1.75,

    // Random variance applied to a mob's rolled Battle Power and its per-stat split, so two mobs at the same nominal power don't feel identical. 0.4 means plus or minus 40%.
    // Range: 0 to 1
    "statVarianceFraction": 0.4,

    // Chance for any given managed-mob spawn to roll as an Elite instead of a normal mob.
    // Range: 0 to 1
    "eliteChance": 0.05,

    // Elite's target Battle Power multiplier lower bound, applied on top of the normal local difficulty reference (peak player BP in-ring, or the zone's own heat-derived BP beyond it).
    // Range: 1 to 10
    "eliteMinMultiplier": 1.5,

    // Elite's target Battle Power multiplier upper bound.
    // Range: 1 to 10
    "eliteMaxMultiplier": 2.5,

    // Radius, in blocks, used to find the player a spawning DMZ hostile mob should scale against.
    // Also acts as a hard spawn gate - if no player is within this radius, the spawn is canceled outright.
    // Range: 8 to 1024
    "nearbyPlayerSearchRadius": 128

  },

  "peakBattlePower": {
    // How often (in ticks) each online player's Battle Power is sampled to update their persisted peak Battle Power. 20 = 1 second.
    // Samples are skipped while the player has an active stacked form (Kaioken-style) so a temporary spike doesn't get baked in as their new baseline. Peak is persisted per player and only ever increases.
    // Range: 1 to 1200
    "peakBpSampleIntervalTicks": 20

  },

  "combatFormula": {
    // Multiplier feeding this mod's own attack-vs-defense formula for melee-type hits. Tune this to change overall melee damage without touching the formula shape.
    // Range: 0.0001 to 100
    "meleeDamageConstant": 0.05,

    // Same as meleeDamageConstant, but for ki-blast-type hits.
    // Range: 0.0001 to 100
    "kiDamageConstant": 0.06,

    // Safety margin above DMZ's own damage-cancellation cliff (a hit below a certain raw-damage threshold is reduced to exactly zero) that this mod's damage calibration always clears. 1.25 means 25% above the worst-case cliff position.
    // Lowering this risks calibrated hits landing back on the cliff and dealing zero damage intermittently - the exact bug this margin exists to prevent.
    // Range: 1 to 3
    "damageCliffSafetyMargin": 1.25

  },

  "mobAttributes": {
    // Multiplier converting a mob's rolled RES stat into vanilla ARMOR (capped at maxVanillaArmor).
    // Vanilla hard-clamps the effective armor used in its own reduction formula to 20 regardless of the raw attribute value, so armor above roughly 20 is functionally wasted.
    // Range: 0.0001 to 10
    "resistanceToArmorConstant": 0.012,

    // Same as resistanceToArmorConstant but for vanilla ARMOR_TOUGHNESS.
    // This is the stat that matters most for surviving a big hit - unlike armor, toughness has no hard vanilla ceiling.
    // Range: 0.0001 to 10
    "resistanceToToughnessConstant": 0.04,

    // Hard cap on a mob's vanilla ARMOR attribute. 20 is vanilla's own real functional ceiling for the armor damage-reduction formula - any higher value is silently wasted.
    // Range: 1 to 100
    "maxVanillaArmor": 20,

    // Hard cap on a mob's vanilla ARMOR_TOUGHNESS attribute. Unlike armor, toughness has no equivalent hard ceiling in vanilla, so this self-imposed cap is this mod's own choice.
    // Range: 1 to 400
    "maxVanillaToughness": 120

  },

  "naturalSpawner": {
    // Master toggle for this mod fully owning spawning of its managed mobs - Red Ribbon Army, dinosaurs, Sabertooth, Saibaman in the Overworld; Frieza Soldier grunts on Namek; Mini Buu on Sacred Kai Planet; a hand-picked roster on each DMZPlus ground planet.
    // When true, DMZ's and vanilla's own spawn placement for these mobs is canceled and this mod places them instead, always near a player so they're properly stat-gated. Named story bosses are never affected regardless of this setting.
    // If false, managed mobs simply stop spawning anywhere.
    "enableNaturalSpawner": true,

    // How often (in ticks) each online player in a managed dimension rolls a chance to have a managed mob spawned near them. 20 = 1 second.
    // Range: 1 to 12000
    "naturalSpawnCheckIntervalTicks": 20,

    // Chance, per check, that a spawn is actually attempted. The density cap (maxNearbyManagedMobs) is the real throttle, not this rate.
    // Range: 0 to 1
    "naturalSpawnChance": 0.6,

    // Density cap - if a player already has this many of this mod's own managed mobs within nearbyPlayerSearchRadius, no new one spawns for them this check. Vanilla monsters are counted separately, see assumedVanillaMonsterCap.
    // Range: 0 to 128
    "maxNearbyManagedMobs": 12,

    // Minimum distance, in blocks, from the player a newly spawned managed mob can appear.
    // Range: 1 to 512
    "naturalSpawnMinDistance": 20,

    // Maximum distance, in blocks, from the player a newly spawned managed mob can appear.
    // Range: 2 to 1024
    "naturalSpawnMaxDistance": 48,

    // Whether this mod's own managed-mob placement backs off once vanilla's shared monster population near a player is already saturated, instead of spawning up to maxNearbyManagedMobs regardless. Keeps managed spawns from crowding out ordinary vanilla spawns.
    "enableVanillaSpawnCapAwareness": true,

    // Radius, in blocks, used to count nearby hostile monsters (any mod's) before deciding whether the shared budget (assumedVanillaMonsterCap) still has room for one more managed-mob spawn.
    // Range: 8 to 1024
    "vanillaMonsterCapRadius": 136,

    // The shared hostile-monster population this mod assumes vanilla allows near one player before its own natural spawner stops trying. 70 is vanilla's own real constant for a fully-loaded area.
    // Monsters more than a few blocks below the player that can't see the sky are not counted, so caves under a base don't starve out surface spawns.
    // Raise this above 70 to reserve headroom vanilla's own spawner can never fill, letting this mod's own species use it instead.
    // Range: 1 to 1000
    "assumedVanillaMonsterCap": 70,

    // How many blocks below the player's own feet a sky-blind monster must be before it stops counting toward the shared monster cap above. Kept small on purpose - mobs at or near the player's own level always count, wherever they are.
    // Range: 0 to 64
    "undergroundExclusionMinDepth": 4

  },

  "debug": {
    // Logs every rolled mob stat sheet and every calibrated damage value at INFO level. Off by default - this mod's own debug commands are the normal way to check live state.
    "enableDebugLogging": false,

    // Testing only - forces every zone-capsule drop-chance roll to 100% so drops can be observed without grinding real odds. Does not change which kills are eligible, only the chance-based rolls.
    "enableZoneCapsuleDebugAlwaysDrop": false

  },

  "eliteEffects": {
    // Elite mobs roll an extra health multiplier on top of their normal max health, independent of which combat effect they roll. Lower bound of that roll.
    // Range: 1 to 50
    "eliteHealthMultiplierMin": 1.5,

    // Upper bound of the Elite extra-health multiplier roll.
    // Range: 1 to 50
    "eliteHealthMultiplierMax": 3,

    // Extra movement-speed multiplier applied only to Elites that roll the Super Speed effect. 0.6 means plus 60% move speed.
    // Range: 0 to 10
    "eliteSpeedBonusMultiplier": 0.6,

    // Extra armor and armor-toughness multiplier applied only to Elites that roll the Super Defense effect, on top of (not instead of) their normal RES-derived values.
    // Range: 0 to 10
    "eliteDefenseBonusMultiplier": 0.5,

    // Extra multiplier applied to a mob's rolled STR, only for Elites that roll the Super Strength effect, before damage calibration runs.
    // Range: 0 to 10
    "eliteStrengthBonusMultiplier": 0.5,

    // Whether Elite mobs render DMZ's real player-aura billboard mesh. Uses DMZ's own public shader/mesh/texture primitives directly, no Mixin needed.
    "enableEliteAuraMesh": true,

    // Size multiplier for the aura mesh billboard, relative to the mob's own hitbox size.
    // Range: 0.1 to 10
    "eliteAuraMeshScale": 1.3,

    // Hex color (#RRGGBB) of the aura mesh billboard. Independent of the Elite name tag color, which stays gold.
    "eliteAuraColorHex": "#00FFFF"

  },

  "zoneSystem": {
    // Master toggle for the zone/heat difficulty system, across every dimension it applies to (Overworld beyond the ring, plus Namek, Sacred Kai Planet, and the DMZPlus ground planets with no ring at all).
    // If false, every managed mob everywhere uses the older, purely player-relative system exclusively.
    // Inside the Overworld's own starting-zone ring (radius set in dimensions/overworld.json's starting_zone.radius), nothing changes. Beyond it - and everywhere in the other zone-managed dimensions - regular mobs scale off a persistent zone's own accumulated heat instead of the player. Heat only rises, it never decays on its own and has no ceiling.
    "enableZoneSystem": false,

    // The largest a single zone's bounding square can be, in chunks - rounded up to the nearest power of 2. This is the root cell size the zone quadtree recursion starts from, applied uniformly to every managed dimension.
    // Range: 1 to 4096
    "zoneMaxSizeChunks": 16,

    // The smallest a zone's bounding square can shrink to via recursive splitting, in chunks - rounded down to the nearest power of 2.
    // Range: 1 to 4096
    "zoneMinSizeChunks": 8,

    // Probability, at each level of the recursive zone split, that a cell keeps splitting into 4 smaller quadrants instead of becoming one final zone right there. Higher means more, smaller zones on average.
    // Range: 0 to 1
    "zoneSubdivideChance": 0.65,

    // A fresh zone's (zero heat) Battle Power baseline.
    // Range: 1 to 100000000
    "zoneStartingBattlePower": 10000,

    // How often (in ticks) each online player's zone presence is checked for heat accrual. 20 = 1 real second.
    // Range: 1 to 12000
    "heatTickIntervalTicks": 20,

    // Heat added to a player's current zone every heatTickIntervalTicks they spend beyond the spawn ring. Time-based, not kill-based. Two players sharing one zone heat it up twice as fast.
    // Range: 0 to 1000000
    "heatPerTickInterval": 0.1,

    // zoneBattlePower = zoneStartingBattlePower + heatCurveScale times the natural log of (1 + heat / heatCurveMidpoint). Logarithmic, not linear - fast climb early, decelerating later, but never capping.
    // Defaults are fitted to roughly 68,000 BP at 10 minutes of continuous presence, 332,000 at 1 hour, 1,000,000 at 5 hours.
    // Range: 0 to 1000000000000
    "heatCurveScale": 758500,

    // The heat value at which the log curve's growth rate has meaningfully slowed. Lower means the curve flattens sooner; higher means it stays steep longer.
    // Range: 0.001 to 1000000000000
    "heatCurveMidpoint": 660,

    // Once a zone's raw Battle Power reaches the final global tier's own floor (see ZoneHeatLevels), the log heat curve above stops being used - growth switches to a staged, faster, real-time climb instead, unbounded.
    // This is the Battle Power at which that climb speeds up from finalTierStage1RatePerSecond to finalTierStage2RatePerSecond.
    // Range: 1 to 1000000000000
    "finalTierStage2Threshold": 5000000,

    // Battle Power at which the final tier's climb speeds up again, to finalTierStage3RatePerSecond, permanently - there is no further stage past this one.
    // Range: 1 to 1000000000000
    "finalTierStage3Threshold": 10000000,

    // Battle Power gained per real second while in the final tier and below finalTierStage2Threshold.
    // Range: 0 to 1000000000000
    "finalTierStage1RatePerSecond": 25000,

    // Battle Power gained per real second while in the final tier, at or above finalTierStage2Threshold and below finalTierStage3Threshold.
    // Range: 0 to 1000000000000
    "finalTierStage2RatePerSecond": 100000,

    // Battle Power gained per real second while in the final tier, at or above finalTierStage3Threshold. No further ceiling past this - climbs at this rate forever.
    // Range: 0 to 1000000000000
    "finalTierStage3RatePerSecond": 500000,

    // A zone-scaled managed mob's MAX_HEALTH at zero heat: zoneHealth = zoneHealthBase + zoneHealthCurveScale times the natural log of (1 + heat / heatCurveMidpoint). This is its own formula, separate from the in-ring health curve.
    // Range: 1 to 1000000000
    "zoneHealthBase": 500,

    // See zoneHealthBase for the full formula. Fitted to roughly 3,100 HP at 10 minutes of continuous zone presence, 13,500 at 1 hour, 40,000 at 5 hours.
    // Range: 0 to 1000000000000
    "zoneHealthCurveScale": 30000,

    // Client-side HUD panel showing whether you're in the starting ring or a heat-scaled zone, and that zone's current danger tier. Purely cosmetic. Also togglable in-game from the V menu's Config tab.
    "enableZoneHudOverlay": true,

    // Whether the zone HUD panel uses the two raw pixel values below instead of its normal built-in position. Not meant to be hand-edited - drag the sliders in the in-game position screen instead, they write here live.
    "zoneHudUseCustomPosition": false,

    // Raw screen-pixel X for the zone HUD panel's top-left corner, only used while zoneHudUseCustomPosition is true.
    // Range: -4000 to 8000
    "zoneHudCustomX": 0,

    // Raw screen-pixel Y for the zone HUD panel's top-left corner, only used while zoneHudUseCustomPosition is true.
    // Range: -4000 to 8000
    "zoneHudCustomY": 0,

    // How often (in ticks) each loaded managed dimension's zones are checked for passive decay. A zone with no player present long enough for its current level drops one level. 1200 = 60 seconds.
    // Range: 1 to 72000
    "zoneDecayCheckIntervalTicks": 1200,

    // How often (in ticks) a player's presence in a zone is sampled for the decay countdown reset. 10 = half a second.
    // Range: 1 to 1200
    "zonePresenceSampleIntervalTicks": 10

  },

  "zoneBossGate": {
    // Master toggle for the zone-heat-level gate mechanic.
    // When true, a zone's effective Battle Power is capped at whatever level it's currently unlocked to, regardless of how high its real, continuously-accumulating heat has climbed. Advancing a level requires a zone boss to be spawned and killed. When false, heat translates directly into difficulty with no gate at all.
    "enableZoneBossGate": true,

    // A zone boss's target Battle Power is the level it's gating's own ceiling times this - deliberately well above what a normal mob at that level would roll.
    // Range: 1 to 100
    "zoneBossBattlePowerMultiplier": 3,

    // Extra flat multiplier on a zone boss's health, on top of the normal curve-derived value its boosted Battle Power would already produce.
    // Range: 1 to 50
    "zoneBossHealthMultiplier": 4,

    // Model scale for zone bosses. Also drives the hitbox scale (see enableBossHitboxScale) - the two are never independent.
    // Range: 1 to 20
    "zoneBossSizeScale": 5,

    // Whether a zone or world boss's real hitbox scales up to match its visual model size, on top of the render-only scale. Not applied to Elites.
    "enableBossHitboxScale": true

  },

  "mapIntegration": {
    // Draws each zone as a colored polygon on JourneyMap's map, if installed. Requires journeymap - silently does nothing without it, this mod has no hard dependency on JourneyMap. On by default.
    "enableJourneyMapZoneOverlay": true,

    // How many chunks around each player, every zone map sync cycle, get proactively assigned a zone id if they don't already have one. Without this, the map overlay is a sparse scatter instead of solid regions.
    // Range: 0 to 64
    "zoneMapEagerResolveChunkRadius": 16,

    // Radius, in blocks, around each player within which zone map data is synced to their client. Zones beyond this simply aren't sent until the player travels closer - anything already synced stays on the client's map permanently.
    // Range: 512 to 16384
    "zoneMapSyncRadiusBlocks": 2048,

    // JourneyMap only - caps how many zone-heat text labels show on the map at once, so a heavily-explored map doesn't turn into a wall of text. The zone's colored fill and outline are never affected, only the text label.
    // Favorited zones are never subject to this cap. Set to a very large number to effectively disable the cap.
    // Range: 0 to 100000
    "journeyMapMaxVisibleZoneLabels": 25,

    // JourneyMap only - this player's own show/hide state for the whole zone overlay, flipped by the toggle button on JourneyMap's own toolbar rather than edited here directly. Purely visual and per-player.
    "journeyMapZoneOverlayVisible": true,

    // How often (in ticks) a full zone-map resync runs per player. 100 = 5 seconds.
    // Range: 1 to 72000
    "zoneMapFullSyncIntervalTicks": 100,

    // How often (in ticks) newly-resolved zones are checked for map sync. 20 = 1 second.
    // Range: 1 to 72000
    "zoneMapNewZoneCheckIntervalTicks": 20,

    // Maximum number of newly-explored map cells synced to one player in a single cycle, so a fully-explored surrounding fills in over a few seconds instead of one large burst.
    // Range: 1 to 10000
    "zoneMapMaxNewCellsPerSync": 128,

    // Client-side - how often (in ticks) the nearest-zones label list is recalculated as the player moves. 100 = 5 seconds, matching the server's own sync cadence.
    // Range: 1 to 72000
    "zoneMapLabelReevaluateIntervalTicks": 100,

    // Outline color (0xRRGGBB) used by the zone map overlay (JourneyMap).
    // Range: 0 to 16777215
    "zoneOverlayOutlineColor": 0,

    // Zone fill opacity, 0 to 1, shared across every map overlay.
    // Range: 0 to 1
    "zoneOverlayFillOpacity": 0.2745,

    // Fill opacity for a favorited or hovered zone, 0 to 1, shared across every map overlay.
    // Range: 0 to 1
    "zoneOverlayHighlightFillOpacity": 0.6275,

    // Zone border opacity, 0 to 1, shared across every map overlay. This border is the real mechanism separating adjacent zones, not just a cosmetic accent, so it stays fairly opaque by default.
    // Range: 0 to 1
    "zoneOverlayStrokeOpacity": 0.8627,

    // Border opacity for a favorited or hovered zone, 0 to 1, shared across every map overlay.
    // Range: 0 to 1
    "zoneOverlayHighlightStrokeOpacity": 1,

    // Zone border width in pixels, shared across every map overlay.
    // Range: 0.1 to 20
    "zoneOverlayStrokeWidth": 2.5,

    // Border width in pixels for a favorited or hovered zone, shared across every map overlay.
    // Range: 0.1 to 20
    "zoneOverlayHighlightStrokeWidth": 4

  },

  "kiSense": {
    // Recolors DMZ's own ki-sense Battle Power floating label - DMZ's own default (white) washes out against a bright sky.
    "enableKiSenseBpColor": true,

    // The BP label's fill color as a 0xRRGGBB hex number, only used while enableKiSenseBpColor is true.
    // Range: 0 to 16777215
    "kiSenseBpColor": 5592575,

    // Repositions DMZ's own ki-sense combat overlay to anchor above this mod's own boss or Elite name tag instead of DMZ's fixed offset, and enlarges it.
    "enableKiSenseOverlayRescale": true,

    // Flat size multiplier applied to the whole ki-sense overlay on top of DMZ's own default size, only while enableKiSenseOverlayRescale is true.
    // Range: 1 to 5
    "kiSenseReadabilityMultiplier": 1.75,

    // Extra size multiplier for the BP label's own text specifically, stacked on top of kiSenseReadabilityMultiplier.
    // Range: 1 to 5
    "kiSenseBpTextMultiplier": 1.4,

    // Extra vertical gap, in blocks, between this mod's own name tag and the ki-sense overlay rendered above it, only while enableKiSenseOverlayRescale is true.
    // Range: 0 to 5
    "kiSenseAboveNameTagMargin": 0.4

  },

  "zoneCapsuleLoot": {
    // Master toggle for zone-tier capsule loot drops from managed-mob kills in high-tier zones.
    "enableZoneCapsuleLoot": true,

    // Minimum zone-heat level a kill's zone must be at for any capsule drop to be possible. For a zone boss kill, this checks the boss's own gated level instead of the zone's pre-fight state.
    // Range: 1 to 5
    "zoneCapsuleTierRequirement": 4,

    // Chance an ordinary managed-mob kill in an eligible zone drops exactly 1 capsule. Deliberately rare.
    // Range: 0 to 1
    "zoneCapsuleRegularDropChance": 0.0001,

    // Chance an Elite kill in an eligible zone drops exactly 1 capsule.
    // Range: 0 to 1
    "zoneCapsuleEliteDropChance": 0.1,

    // A zone boss kill always drops at least this many capsules, each independently rolled, before any bonus rolls.
    // Range: 0 to 100
    "zoneBossCapsuleGuaranteedCount": 2,

    // After the guaranteed drops, a zone boss kill rolls up to zoneBossCapsuleMaxBonusRolls independent chances at this probability each for one more capsule.
    // Range: 0 to 1
    "zoneBossCapsuleBonusRollChance": 0.4,

    // How many bonus-roll attempts a zone boss kill gets on top of the guaranteed count.
    // Range: 0 to 100
    "zoneBossCapsuleMaxBonusRolls": 3

  },

  "structureSpawnGuard": {
    // Vetoes any hostile mob spawn, vanilla or DMZ, that would land inside or near a real DMZ structure.
    // Reuses DMZ's own real structure-protection tag, so any structure DMZ adds to that tag in a future version is picked up automatically with zero code changes.
    "enableStructureSpawnExclusion": true,

    // Horizontal padding, in blocks, added around a DMZ structure's own real bounding box. The excluded zone applies at any height.
    // Range: 0 to 512
    "structureExclusionMargin": 24

  },

  "worldBoss": {
    // Master toggle for the periodic world boss - a rare, massive, server-wide event boss scaled to the whole online population, distinct from the per-zone gate bosses.
    "enableWorldBoss": true,

    // How often (in ticks) the server checks whether it's time to spawn a new world boss. 20 = 1 second. Purely a check cadence, not a gameplay value.
    // Range: 1 to 72000
    "worldBossCheckIntervalTicks": 100,

    // How long (in ticks) after a world boss dies, or after the world is first loaded, before the next one becomes eligible to spawn. 216000 = 3 real hours. See worldBossDebugInstantRespawn to shrink this for testing.
    // Range: 20 to 2147483647
    "worldBossSpawnIntervalTicks": 216000,

    // Testing only - forces the post-death cooldown down to a few seconds instead of the real worldBossSpawnIntervalTicks. Does not affect the boss's own stats or scaling.
    "worldBossDebugInstantRespawn": false,

    // Shows a live, continuously-updating marker for the current world boss's real position on JourneyMap, for as long as it's alive. Requires JourneyMap installed.
    "enableWorldBossMapTracker": true,

    // How often (in ticks) the world boss's map marker position is refreshed while alive. 40 = 2 seconds.
    // Range: 1 to 72000
    "worldBossMapTrackerUpdateIntervalTicks": 40,

    // Hard floor for a world boss's target Battle Power, regardless of how weak the online population's average peak BP is.
    // Range: 1 to 1000000000000
    "worldBossMinBattlePower": 50000,

    // A world boss's target Battle Power is the average online player peak BP times (1 plus (player count minus 1) times this), floored by worldBossMinBattlePower. More players online makes the boss genuinely harder, not just averaged.
    // Range: 0 to 10
    "worldBossPlayerCountScale": 0.15,

    // Hard MAX_HEALTH floor for a world boss - only ever binding if no online player has a created DMZ character to size real damage-based HP off of.
    // Range: 1 to 1000000000000
    "worldBossMinHealth": 3000000,

    // Solo world boss HP formula - HP equals one online player's real peak melee damage, mitigated through the boss's own rolled defense, times this many seconds times worldBossAssumedHitsPerSecond. 900 = 15 minutes.
    // Range: 1 to 1000000
    "worldBossSoloDurationSeconds": 900,

    // Assumed non-stop melee hit rate used by both the solo and group world boss HP formulas. 4.0 matches vanilla's own baseline unarmed attack speed.
    // Range: 0.1 to 100
    "worldBossAssumedHitsPerSecond": 4,

    // Group world boss HP formula (2 or more online players), replacing the solo duration target entirely - HP equals this value times the sum of every valid player's own real mitigated melee damage times the player count.
    // Range: 1 to 1000000000
    "worldBossGroupHitsPerPlayer": 300,

    // Model scale for the world boss. Also drives the hitbox scale - the two are never independent.
    // Range: 1 to 50
    "worldBossSizeScale": 10,

    // Minimum distance, in blocks, a world boss can spawn from any currently online player in the target dimension, not just whichever one the spawn roll picked as its anchor.
    // Range: 0 to 100000
    "worldBossMinSpawnDistance": 300,

    // Minimum number of chunks a real player has actually been near, in valid non-safe-zone territory, the target dimension must have before a world boss is willing to spawn there at all.
    // Key name kept as worldBossMinGeneratedChunks even though it now measures visited chunks specifically, so the config shape doesn't need to change for a pure rename.
    // Range: 1 to 10000000
    "worldBossMinGeneratedChunks": 300,

    // A world boss kill's total Training Point reward pool is its own target Battle Power times this, split proportionally by real damage dealt among every player who damaged it. Separate from DMZ's own native per-kill TP payout, which still happens too.
    // Range: 0 to 1000
    "worldBossTpPoolBattlePowerMultiplier": 1,

    // Extra fraction added on top of the MVP's own proportional TP share. The MVP is whoever dealt the single most real damage over the whole fight.
    // Range: 0 to 100
    "worldBossMvpBonusFraction": 0.5,

    // How often (in ticks) each online player's current position is recorded as visited territory for the world boss spawn search. 100 = 5 seconds - chunks don't move, so this doesn't need to be fast.
    // Range: 1 to 72000
    "worldBossVisitTrackIntervalTicks": 100,

    // How often (in ticks) a live world boss is checked and pulled back down if it's drifted above real terrain height. 5 ticks means 4 times a second - deliberately much more frequent than the spawn-timer check, since a mob actively flying can gain real height in just a couple of seconds.
    // Range: 1 to 200
    "worldBossGroundingCheckIntervalTicks": 5,

    // Rolled stat-point range for a Zone Capsule dropped by the world boss - deliberately far above even the zoneCapsuleTier5 range, matching this being the rarest, biggest event in the mod.
    // Range: 1 to 100000
    "worldBossCapsuleMinPoints": 250,

    // Upper bound of the world boss's capsule roll range.
    // Range: 1 to 100000
    "worldBossCapsuleMaxPoints": 500,

    // A world boss kill always drops at least this many capsules, each independently rolled.
    // Range: 0 to 100
    "worldBossCapsuleGuaranteedCount": 3,

    // After the guaranteed drops, a world boss kill rolls up to worldBossCapsuleMaxBonusRolls independent chances at this probability each for one more capsule.
    // Range: 0 to 1
    "worldBossCapsuleBonusRollChance": 0.5,

    // How many bonus-roll attempts a world boss kill gets on top of the guaranteed count.
    // Range: 0 to 100
    "worldBossCapsuleMaxBonusRolls": 2,

    // Hard ceiling on total capsules from a single world boss kill, always enforced regardless of how the guaranteed count and bonus rolls above are tuned.
    // Range: 1 to 1000
    "worldBossCapsuleMaxCount": 5

  },

  "spaceDanger": {
    // Shows a danger-rating popup while flying near a tracked planet in DMZPlus deep space - star rating, Battle Power range, and Zone Tiers. Requires DMZPlus installed, silently does nothing without it.
    // A planet with no tier_range configured (currently only Otherworld) shows as a Safe Zone instead of a danger rating.
    "enableSpaceDangerOverlay": true,

    // How often (in ticks) each online player in deep space is checked against every reachable planet's real live position for proximity. 20 = 1 second.
    // Range: 1 to 1200
    "spaceDangerCheckIntervalTicks": 20,

    // Distance, in blocks, from a planet's real live position (read from DMZPlus's own SpaceMap, always correct regardless of world seed or DMZPlus's own placement mode) within which its danger overlay shows. Independent of DMZPlus's own orbitCaptureRadius/doomWarningRadius.
    // Range: 8 to 30000000
    "spaceDangerProximityRadius": 6000,

    // Whether the space danger popup uses the two raw pixel values below instead of its normal built-in top-center position. Not meant to be hand-edited - drag the sliders in the in-game position screen instead, they write here live.
    "spaceDangerUseCustomPosition": false,

    // Raw screen-pixel X for the space danger popup's top-left corner, only used while spaceDangerUseCustomPosition is true.
    // Range: -4000 to 8000
    "spaceDangerCustomX": 0,

    // Raw screen-pixel Y for the space danger popup's top-left corner, only used while spaceDangerUseCustomPosition is true.
    // Range: -4000 to 8000
    "spaceDangerCustomY": 0

  }
}
